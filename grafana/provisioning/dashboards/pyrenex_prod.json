{
  "uid": "pyrenex-prod", "title": "Pyrenex Prod", "schemaVersion": 39,
  "panels": [{
    "type": "stat", "title": "🔴 Service KO (model / backend)",
    "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "fieldConfig": {
      "defaults": {
        "mappings": [
          {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
        ],
        "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "red"}, {"value": 1, "color": "green"}]}
      }
    },
    "targets": [{
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "up{job=~\"model|backend\"}",
      "legendFormat": "{{job}}"
    }]
  },
  {
    "type": "timeseries", "title": "🟠 Vitesse — p50/p95/p99 (model / backend)",
    "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "fieldConfig": {
      "defaults": {
        "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"value": null, "color": "green"}, {"value": 0.5, "color": "red"}]}
      }
    },
    "targets": [{
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"model\"}[5m])) by (le))",
      "legendFormat": "model p50"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"model\"}[5m])) by (le))",
      "legendFormat": "model p95"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"model\"}[5m])) by (le))",
      "legendFormat": "model p99"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
      "legendFormat": "backend p50"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
      "legendFormat": "backend p95"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
      "legendFormat": "backend p99"
    }]
  },
  {
    "type": "piechart", "title": "🟡 Comportement — Distribution des prédictions",
    "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "options": {"pieType": "donut", "displayLabels": ["name", "percent"]},
    "targets": [{
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(pyrenex_predictions_total{job=\"model\", predicted_class=\"0\"}) or vector(0)",
      "legendFormat": "Classe 0"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(pyrenex_predictions_total{job=\"model\", predicted_class=\"1\"}) or vector(0)",
      "legendFormat": "Classe 1"
    }]
  },
  {
    "type": "timeseries", "title": "Vie — RPS, erreurs et erreurs upstream par type",
    "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "targets": [{
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(rate(http_requests_total{job=\"model\"}[1m]))",
      "legendFormat": "RPS total"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(rate(http_requests_total{job=\"model\", status=~\"4..|5..\"}[1m])) or vector(0)",
      "legendFormat": "Erreurs/s"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(rate(backend_model_upstream_errors_total{job=\"backend\"}[5m])) by (kind) or vector(0)",
      "legendFormat": "upstream: {{kind}}"
    }]
  },
  {
    "type": "timeseries", "title": "Vitesse (détail) — appel interne backend→model (p50/p95/p99)",
    "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32},
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "targets": [{
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.50, sum(rate(backend_model_call_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
      "legendFormat": "p50"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.95, sum(rate(backend_model_call_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
      "legendFormat": "p95"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.99, sum(rate(backend_model_call_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
      "legendFormat": "p99"
    }]
  },
  {
    "type": "timeseries", "title": "Comportement (détail) — distribution de la probabilité de défaut",
    "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "targets": [{
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.50, sum(rate(pyrenex_prediction_proba_bucket{job=\"model\"}[5m])) by (le))",
      "legendFormat": "p50"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.90, sum(rate(pyrenex_prediction_proba_bucket{job=\"model\"}[5m])) by (le))",
      "legendFormat": "p90"
    }]
  },
  {
    "type": "timeseries", "title": "Comportement — probabilites predites (mediane / p90)",
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
    "description": "Le modele hesite-t-il plus qu'avant ? Histogramme expose par le service model.",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "fieldConfig": {
      "defaults": {"unit": "short", "min": 0, "max": 1},
      "overrides": []
    },
    "targets": [{
      "refId": "A",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.5, sum(rate(pyrenex_prediction_proba_bucket{job=\"model\"}[1h])) by (le))",
      "legendFormat": "mediane"
    },
    {
      "refId": "B",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "histogram_quantile(0.9, sum(rate(pyrenex_prediction_proba_bucket{job=\"model\"}[1h])) by (le))",
      "legendFormat": "p90"
    }]
  },
  {
    "type": "timeseries", "title": "Comportement — repartition des classes predites",
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
    "description": "La proportion de defauts annonces a-t-elle bouge ?",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "fieldConfig": {
      "defaults": {"unit": "short"},
      "overrides": []
    },
    "targets": [{
      "refId": "A",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(rate(pyrenex_predictions_total{job=\"model\"}[5m])) by (predicted_class)",
      "legendFormat": "classe {{predicted_class}}"
    }]
  },
  {
    "type": "timeseries", "title": "Contexte — volume et taux d'erreur",
    "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
    "description": "Y a-t-il assez de trafic pour conclure ?",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "fieldConfig": {
      "defaults": {"unit": "short"},
      "overrides": []
    },
    "targets": [{
      "refId": "A",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(rate(http_requests_total{job=~\"model|backend\"}[5m]))",
      "legendFormat": "RPS total"
    },
    {
      "refId": "B",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "sum(rate(http_requests_total{job=~\"model|backend\",status=~\"4..|5..\"}[5m])) or vector(0)",
      "legendFormat": "erreurs 4xx/5xx"
    }]
  },
  {
    "type": "timeseries", "title": "Contexte — taux de refus (pas 10s)",
    "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
    "description": "Part des demandes classees en defaut (classe 1). Scrape toutes les 1s, fenetre 5s (minimum pour que rate() ait au moins 2 points).",
    "datasource": {"type": "prometheus", "uid": "prometheus"},
    "fieldConfig": {
      "defaults": {"unit": "percent", "min": 0, "max": 100},
      "overrides": []
    },
    "targets": [{
      "refId": "A",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "expr": "100 * sum(rate(pyrenex_predictions_total{job=\"model\",predicted_class=\"1\"}[10s])) / sum(rate(pyrenex_predictions_total{job=\"model\"}[10s]))",
      "legendFormat": "taux de refus"
    }]
  }]
}
